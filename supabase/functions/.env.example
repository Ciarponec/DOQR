# Copy to .env for local Edge Function development. Never commit real values.
VISITOR_IP_HASH_SALT=replace-with-a-long-random-secret
VISITOR_DEVICE_HASH_SALT=replace-with-a-different-long-random-secret
COURIER_NOTE_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64url

# Required only when the related production features are enabled.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
APPLE_APP_ID=com.doqr.app
